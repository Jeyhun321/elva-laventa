{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "if (Test-Path \".agents/skills/impeccable/scripts/hook.mjs\") {\n    & node \".agents/skills/impeccable/scripts/hook.mjs\"\n} else {\n    exit 0\n}",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if (Test-Path \".agents/skills/impeccable/scripts/hook.mjs\") {\n    & node \".agents/skills/impeccable/scripts/hook.mjs\"\n} else {\n    exit 0\n}",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          }
        ]
      }
    ]
  }
}
