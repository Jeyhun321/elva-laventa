# Elva LaVenta — доступ к логам локально.
# Скопируй этот файл в tools/.env.logs и впиши свои значения.
# tools/.env.logs в .gitignore — в репозиторий он НЕ попадёт.
#
# Оба значения бери в Supabase: Project Settings → API.
# service_role ключ — секретный, обходит защиту (RLS). Никому не показывай,
# не коммить, не вставляй в браузер публичного сайта.

SUPABASE_URL=https://ВАШ-ПРОЕКТ.supabase.co
SUPABASE_SERVICE_ROLE_KEY=ВАШ_SERVICE_ROLE_КЛЮЧ
